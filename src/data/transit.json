  "rules": [
    {
      "id": "short-walk-cycle",
      "when": {
        "band": ["short"],
        "mode": ["car", "two_wheeler", "auto"],
        "level": ["good", "satisfactory", "moderate"]
      },
      "then": {
        "title": "Walk or cycle this short trip",
        "body": "At {km} km each way this trip is short enough to walk or cycle. Today the air is {levelLabel}, so it is a reasonable day for it. Keep to quieter lanes away from heavy traffic where you can.",
        "reason": "The GRAP citizens charter, written for Delhi NCR, asks people to walk or cycle for small distances. Saans suggests it only when the air is Moderately polluted or better, because in a Delhi study people on foot breathed more fine particles per minute than people inside vehicles.",
        "impact": {
          "kind": "distance",
          "text": "About {weekKm} fewer km by {vehicle} each week: {km} km one way, there and back, on {days} days a week. This assumes you make the trip on each of those days.{exposureNote}",
          "numbers": ["weekKm", "km", "days"]
        }
      },
      "source": {
        "id": "grap-walk-cycle",
        "title": "CAQM Graded Response Action Plan, citizens charter (revision 21.11.2025)",
        "url": "https://web.archive.org/web/2025/https://caqm.nic.in/WriteReadData/LINKS/GRAP%20Order47928aa8-d026-4478-9407-2eba0a328a2d.pdf",
        "quote": "Walk or use cycles for small distances.",
        "status": "P-READ"
      }
    },
    {
      "id": "mid-transit-rail",
      "when": {
        "band": ["mid"],
        "mode": ["car", "two_wheeler", "auto"],
        "rail": [true]
      },
      "then": {
        "title": "Try {options} for this trip",
        "body": "At {km} km each way, {options} could cover this trip. Check the route map for stations near your home and your destination.{links}",
        "reason": "The health ministry advises using public transport whenever possible on polluted days.",
        "impact": {
          "kind": "distance",
          "text": "About {weekKm} fewer km by {vehicle} each week: {km} km one way, there and back, on {days} days a week. This assumes you make the trip on each of those days.{exposureNote}",
          "numbers": ["weekKm", "km", "days"]
        },
        "exposure": "transit"
      },
      "source": {
        "id": "mohfw-public-transport",
        "title": "Ministry of Health and Family Welfare, Advisory on Air Pollution and Health, Annexure II item 20",
        "url": "https://ncdc.mohfw.gov.in/uploads/pdf/air2.pdf",
        "quote": "Use public transport whenever possible to reduce air pollution.",
        "status": "P-READ"
      }
    },
