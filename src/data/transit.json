    {
      "id": "carpool",
      "when": {
        "mode": ["car"],
        "band": ["short", "mid", "long"]
      },
      "then": {
        "title": "Share this ride with another household",
        "body": "If another household is going your way, take turns driving. Each of you then drives on half the days.",
        "reason": "The GRAP citizens charter, written for Delhi NCR, asks people to share a ride or use public transport. Taking turns with one other household is a Saans assumption.",
        "impact": {
          "kind": "distance",
          "text": "Your car would do about {halfKm} fewer km each week, half of the {weekKm} km it does now ({km} km one way, there and back, on {days} days a week).",
          "numbers": ["halfKm", "weekKm", "km", "days"]
        }
      },
      "source": {
        "id": "grap-share-ride",
        "title": "CAQM Graded Response Action Plan, citizens charter (revision 21.11.2025)",
        "url": "https://web.archive.org/web/2025/https://caqm.nic.in/WriteReadData/LINKS/GRAP%20Order47928aa8-d026-4478-9407-2eba0a328a2d.pdf",
        "quote": "Choose a cleaner commute. Share a ride to work or use public transport.",
        "status": "P-READ"
      }
    },
    {
      "id": "no-idling",
      "when": {
        "mode": ["car"]
      },
      "then": {
        "title": "Switch the engine off when you wait",
        "body": "Turn the engine off at red lights and while you wait for someone. Do it if the wait will be longer than about 15 seconds.",
        "reason": "The GRAP citizens charter asks drivers not to idle and to turn off the engine at red lights. PCRA, the oil ministry fuel-saving body, advises switching off beyond 15 seconds at a red light.",
        "impact": {
          "kind": "none",
          "text": "Not quantified: Saans has no sourced idling figure for Indian cars.",
          "numbers": []
        }
      },
      "source": {
        "id": "grap-no-idling",
        "title": "CAQM Graded Response Action Plan, citizens charter (revision 21.11.2025)",
        "url": "https://web.archive.org/web/2025/https://caqm.nic.in/WriteReadData/LINKS/GRAP%20Order47928aa8-d026-4478-9407-2eba0a328a2d.pdf",
        "quote": "Do not idle your vehicle, also turn off the engine at red lights.",
        "status": "P-READ"
      },
      "alsoSource": {
        "id": "pcra-15-seconds",
        "title": "Press Information Bureau, Ministry of Petroleum and Natural Gas, 18 January 2008",
        "url": "https://www.pib.gov.in/newsite/erelcontent.aspx?relid=34747",
        "quote": "This wastage may be saved simply by switching off vehicle engine beyond 15 seconds at traffic red lights.",
        "status": "P-READ"
      }
    },
    {
      "id": "combine-errands",
      "when": {
        "kind": ["errand"],
        "mode": ["car", "two_wheeler", "auto"],
        "repeats": [true]
      },
      "then": {
        "title": "Combine your errands into one trip",
        "body": "You make this errand trip on {days} days a week. Doing the errands together in one trip leaves {tripsSaved} fewer trips.",
        "reason": "The GRAP citizens charter, written for Delhi NCR, asks people to combine errands and reduce trips.",
        "impact": {
          "kind": "distance",
          "text": "About {saved} fewer km by {vehicle} each week: {tripsSaved} fewer trips of {km} km one way, there and back. This assumes everything fits into one trip.",
          "numbers": ["saved", "tripsSaved", "km"]
        }
      },
      "source": {
        "id": "grap-combine-errands",
