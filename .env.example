# Copy to .env and replace every placeholder. Never commit .env.
#
# SEAL_KEY and FORM_KEY must each be 32 random bytes, base64 encoded. Generate one per line with:
#   openssl rand -base64 32
# Rotating SEAL_KEY invalidates every shared household link.
SEAL_KEY=replace-with-output-of-openssl-rand-base64-32
FORM_KEY=replace-with-output-of-openssl-rand-base64-32

# Optional. Without a Gemini key the app uses its template text instead of generated text.
GEMINI_API_KEY=
GEMINI_MODEL_READER=gemini-3.5-flash-lite
GEMINI_MODEL_WRITER=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# Optional. A free OpenAQ key enables the "measured nearby" line.
OPENAQ_API_KEY=
