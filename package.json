{
  "name": "saans",
  "version": "0.1.0",
  "private": true,
  "description": "Saans: a household plan for living with poor air in India.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check:repo": "tsx scripts/check-repo.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run check:repo"
  },
  "dependencies": {
    "@google/genai": "3.0.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
